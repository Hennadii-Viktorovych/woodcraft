<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Адмін-панель</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
<nav class="navbar navbar-dark bg-dark px-3">
    <span class="navbar-brand">Панель керування</span>
    <a href="/logout" class="btn btn-outline-light btn-sm">Вийти</a>
</nav>

<div class="container mt-4">
    <h2>Вітаємо, <%= user.username %>!</h2>

    <!-- Форма додавання контенту -->
    <div class="card my-4 p-3">
        <h4>Додати новий запис</h4>
        <form action="/posts/add" method="POST">
            <div class="mb-2">
                <input type="text" name="title" class="form-control" placeholder="Заголовок" required>
            </div>
            <div class="mb-2">
                <textarea name="content" class="form-control" placeholder="Текст" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-success">Опублікувати</button>
        </form>
    </div>

    <!-- Таблиця з контентом -->
    <h4>Існуючі записи</h4>
    <table class="table table-bordered mt-2">
        <thead>
        <tr>
            <th>ID</th>
            <th>Заголовок</th>
            <th>Контент</th>
            <th>Дії</th>
        </tr>
        </thead>
        <tbody>
        <% posts.forEach(post => { %>
            <tr>
                <td><%= post.id %></td>
                <td><%= post.title %></td>
                <td><%= post.content %></td>
                <td>
                    <form action="/posts/delete/<%= post.id %>" method="POST" style="display:inline;">
                        <button class="btn btn-danger btn-sm" onclick="return confirm('Видалити?')">Видалити</button>
                    </form>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
</div>
</body>
</html>