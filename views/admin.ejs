<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Панель управління — WOODCRAFT</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { background: #0f0f11; color: #e0e0e0; padding: 30px; }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #18181c;
            border: 1px solid #2a2a30;
            padding: 20px 30px;
            border-radius: 12px;
            margin-bottom: 30px;
        }
        .header h1 { font-size: 22px; color: #fff; letter-spacing: 1px; }
        .logout-btn {
            background: #e74c3c;
            color: #fff;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 600;
            transition: 0.2s;
        }
        .logout-btn:hover { background: #c0392b; }

        .grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        @media (max-width: 900px) {
            .grid { grid-template-columns: 1fr; }
        }

        .card {
            background: #18181c;
            border: 1px solid #2a2a30;
            border-radius: 12px;
            padding: 25px;
        }

        h2 {
            font-size: 18px;
            color: #d4a373;
            margin-bottom: 20px;
            border-bottom: 1px solid #2a2a30;
            padding-bottom: 10px;
        }

        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 6px; font-size: 14px; color: #aaa; }
        .form-group input[type="text"], .form-group textarea, .form-group input[type="file"] {
            width: 100%;
            padding: 10px 12px;
            background: #0f0f11;
            border: 1px solid #333;
            border-radius: 6px;
            color: #fff;
            font-size: 14px;
        }
        .form-group textarea { resize: vertical; height: 80px; }
        .checkbox-group { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .checkbox-group input { width: 18px; height: 18px; accent-color: #d4a373; }

        .btn-submit {
            width: 100%;
            background: #d4a373;
            color: #111;
            font-weight: bold;
            padding: 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 10px;
        }
        .btn-submit:hover { background: #c29263; }

        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { text-align: left; padding: 12px; border-bottom: 1px solid #2a2a30; font-size: 14px; }
        th { background: #111114; color: #888; font-weight: 600; }
        td img { width: 45px; height: 45px; object-fit: cover; border-radius: 6px; }

        .btn-delete {
            background: transparent;
            color: #e74c3c;
            border: 1px solid #e74c3c;
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn-delete:hover { background: #e74c3c; color: #fff; }

        .btn-star {
            background: transparent;
            border: 1px solid #555;
            color: #888;
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn-star.active {
            border-color: #f1c40f;
            color: #f1c40f;
            background: rgba(241, 196, 15, 0.1);
        }

        .actions-cell { display: flex; gap: 8px; }
        .empty-msg { color: #666; font-style: italic; }
    </style>
</head>
<body>

<div class="header">
    <h1>🪵 WOODCRAFT Admin Panel</h1>
    <a href="/admin/logout" class="logout-btn">Вийти</a>
</div>

<div class="grid">
    <!-- Форма -->
    <div class="card">
        <h2>Додати новий товар</h2>
        <form action="/admin/products/add" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Назва товару</label>
                <input type="text" name="title" required placeholder="напр., Обробна дошка Дуб">
            </div>
            <div class="form-group">
                <label>Опис</label>
                <textarea name="description" placeholder="Короткий опис товару..."></textarea>
            </div>
            <div class="form-group">
                <label>Ціна (грн)</label>
                <input type="text" name="price" required placeholder="1200">
            </div>
            <div class="form-group">
                <label>Фото товару</label>
                <input type="file" name="image" accept="image/*">
            </div>
            <div class="form-group">
                <label class="checkbox-group">
                    <input type="checkbox" name="is_popular" value="1">
                    <span>⭐ Показати у Популярних продуктах</span>
                </label>
            </div>
            <button type="submit" class="btn-submit">Опублікувати товар</button>
        </form>
    </div>

    <!-- Список товарів -->
    <div class="card">
        <h2>Товари у каталозі (<%= products ? products.length : 0 %>)</h2>
        <% if (products && products.length > 0) { %>
            <table>
                <thead>
                <tr>
                    <th>Фото</th>
                    <th>Назва</th>
                    <th>Ціна</th>
                    <th>Популярне</th>
                    <th>Дії</th>
                </tr>
                </thead>
                <tbody>
                <% products.forEach(product => { %>
                    <tr>
                        <td><img src="<%= product.image %>" alt=""></td>
                        <td><strong><%= product.title %></strong></td>
                        <td><%= product.price %> грн</td>
                        <td>
                            <form action="/admin/products/toggle-popular/<%= product.id %>" method="POST">
                                <button type="submit" class="btn-star <%= product.is_popular ? 'active' : '' %>">
                                    <%= product.is_popular ? '★ В популярних' : '☆ Додати' %>
                                </button>
                            </form>
                        </td>
                        <td>
                            <form action="/admin/products/delete/<%= product.id %>" method="POST" onsubmit="return confirm('Видалити цей товар?');">
                                <button type="submit" class="btn-delete">Видалити</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <p class="empty-msg">Товарів у базі поки немає.</p>
        <% } %>
    </div>
</div>

<!-- Заявки -->
<div class="card">
    <h2>Заявки від клієнтів (<%= requests ? requests.length : 0 %>)</h2>
    <% if (requests && requests.length > 0) { %>
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Ім'я</th>
                <th>Телефон</th>
                <th>Тема</th>
                <th>Повідомлення</th>
                <th>Дата</th>
                <th>Дія</th>
            </tr>
            </thead>
            <tbody>
            <% requests.forEach(req => { %>
                <tr>
                    <td>#<%= req.id %></td>
                    <td><strong><%= req.name %></strong></td>
                    <td><%= req.phone %></td>
                    <td><%= req.subject || '-' %></td>
                    <td><%= req.message || '-' %></td>
                    <td><%= req.date || '-' %></td>
                    <td>
                        <form action="/admin/requests/delete/<%= req.id %>" method="POST" onsubmit="return confirm('Видалити заявку?');">
                            <button type="submit" class="btn-delete">Видалити</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <p class="empty-msg">Заявок від клієнтів поки немає.</p>
    <% } %>
</div>

</body>
</html>